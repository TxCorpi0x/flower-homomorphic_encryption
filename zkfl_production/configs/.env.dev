# ZKFL Development Environment Configuration

# Server Configuration
NUM_ROUNDS=3
MIN_NUM_CLIENTS=1
MIN_AVAILABLE_CLIENTS=1
MIN_FIT_CLIENTS=1
MIN_EVAL_CLIENTS=1
SERVER_PORT=8080

# Security Configuration (disabled for development)
ZK_ENABLED=false
DP_ENABLED=false
BLOCKCHAIN_ENABLED=false

# Performance Settings (faster for development)
BATCH_SIZE=16
LEARNING_RATE=0.01
NUM_EPOCHS=2

# Development Settings
DEBUG=true
LOG_LEVEL=DEBUG

# Networking
SERVER_HOST=localhost
HTTPS_PORT=8443

# Docker Configuration
REGISTRY=localhost:5000
VERSION=dev
PUSH=false