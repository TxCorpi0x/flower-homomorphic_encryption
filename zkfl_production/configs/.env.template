# ZKFL Production Environment Configuration

# Server Configuration
NUM_ROUNDS=10
MIN_NUM_CLIENTS=3
MIN_AVAILABLE_CLIENTS=3
MIN_FIT_CLIENTS=3
MIN_EVAL_CLIENTS=2
SERVER_PORT=8080

# Security Configuration
ZK_ENABLED=true
DP_ENABLED=true
BLOCKCHAIN_ENABLED=false

# Privacy Settings
DP_EPSILON=1.0
DP_DELTA=1e-5
DP_CLIPPING_NORM=1.0

# Performance Settings
BATCH_SIZE=32
LEARNING_RATE=0.01
NUM_EPOCHS=5

# ZK Circuit Configuration
ZK_CIRCUIT_SIZE=1024
ZK_PROVING_KEY_PATH=/app/keys/proving.key
ZK_VERIFICATION_KEY_PATH=/app/keys/verification.key

# Networking
SERVER_HOST=localhost
HTTPS_PORT=8443

# Development Settings
DEBUG=false
LOG_LEVEL=INFO

# Docker/Registry Configuration
REGISTRY=localhost:5000
VERSION=latest
PUSH=false

# Cloud Provider Settings (uncomment as needed)
# AWS_REGION=us-west-2
# GCP_PROJECT=your-project-id
# AZURE_RESOURCE_GROUP=zkfl-rg